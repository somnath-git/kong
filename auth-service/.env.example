# auth-service configuration (DEV-ONLY example values)

# Application database (Postgres) connection.
DB_HOST=app-database
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=appdb

# HTTP server.
PORT=3000

# JWT signing. The issuer MUST match the Kong jwt credential `key`.
JWT_ISSUER=auth-service
JWT_TTL=1h

# RS256 private key path (mounted at runtime, never baked into the image).
PRIVATE_KEY_PATH=/keys/jwtRS256.key
